@startuml 08_Componentes_API_C4
!include <C4/C4_Component>

title Diagrama de Componentes (Nível 3) - Módulos da API

ContainerDb(db, "Banco de dados", "PostgreSQL", "Domínio, sessões e eventos pendentes.")
System_Ext(fipe, "API FIPE", "Fonte de veículos.")
Container_Ext(storage, "Armazenamento de imagens", "S3-compatível", "Fotos e miniaturas.")
System_Ext(email, "Serviço de e-mail", "SMTP.")

Container_Boundary(api, "API (Spring Boot + Spring Modulith)") {
    Component(conta, "conta", "Módulo", "Usuário, perfil de vendedor, perfil de atuação, sessão, aceite de termos.")
    Component(veiculo, "veiculo", "Módulo", "Taxonomia local e adaptador da FIPE.")
    Component(catalogo, "catalogo", "Módulo", "Itens, compatibilidade, fotos e estoque.")
    Component(pedido, "pedido", "Módulo", "Pedido de peça e seu estado.")
    Component(matching, "matching", "Módulo", "Casamento de catálogo e de perfil, ranking, limite N, cotações.")
    Component(negociacao, "negociacao", "Módulo", "Conversa, mensagens, proposta e versões, SSE.")
    Component(notificacao, "notificacao", "Módulo", "Notificações no app e e-mail agrupado.")
    Component(moderacao, "moderacao", "Módulo", "Aprovação de vendedor, denúncia, bloqueio, auditoria.")
    Component(compartilhado, "compartilhado", "Módulo", "Tratamento de imagens, erros e tipos comuns.")
}

' Chamadas diretas (API pública do módulo)
Rel(matching, catalogo, "Consulta itens compatíveis")
Rel(matching, conta, "Consulta perfis de atuação e vendedores aprovados")
Rel(matching, veiculo, "Resolve o veículo do pedido")
Rel(pedido, veiculo, "Valida o veículo")
Rel(catalogo, veiculo, "Valida a compatibilidade")
Rel(negociacao, compartilhado, "Processa e grava imagens")
Rel(catalogo, compartilhado, "Processa e grava imagens")
Rel(moderacao, conta, "Aprova, suspende e bloqueia")

' Eventos de domínio (registro persistido no PostgreSQL)
Rel_R(pedido, matching, "PedidoCriado", "evento")
Rel_R(matching, negociacao, "ItemCatalogoCasado\n(cria a conversa com o cartão)", "evento")
Rel_D(matching, notificacao, "CotacaoCriada", "evento")
Rel_U(negociacao, pedido, "PrimeiraResposta,\nPropostaVendida", "evento")
Rel_L(negociacao, catalogo, "PropostaVendida\n(baixa de estoque)", "evento")
Rel_D(negociacao, notificacao, "MensagemEnviada,\nPropostaAtualizada", "evento")

' Infraestrutura
Rel(veiculo, fipe, "Sincroniza (job)", "HTTPS/JSON")
Rel(compartilhado, storage, "Grava e assina URLs", "API S3")
Rel(notificacao, email, "Envia", "SMTP")
Rel(conta, db, "Lê e grava", "JDBC")
Rel(pedido, db, "Lê e grava", "JDBC")
Rel(negociacao, db, "Lê e grava", "JDBC")

note right of db
  Todos os módulos usam o mesmo PostgreSQL.
  Cada módulo é dono das suas tabelas.
  Só três setas aparecem para não poluir o diagrama.
end note

SHOW_LEGEND()
@enduml

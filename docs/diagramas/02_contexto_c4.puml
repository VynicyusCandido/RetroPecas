@startuml 02_Contexto_C4
!include <C4/C4_Context>

title Diagrama de Contexto (Nível 1) - Marketplace de Autopeças

Person(comprador, "Comprador", "Procura uma peça para carro, moto ou caminhão.")
Person(vendedor, "Vendedor", "Loja, desmanche ou autônomo que vende peças.")
Person(admin, "Administrador", "Aprova vendedores, trata denúncias e mantém as taxonomias.")

System(sistema, "Marketplace de Autopeças", "Recebe o pedido de peça, distribui aos vendedores compatíveis e hospeda o chat de negociação.")

System_Ext(fipe, "API FIPE", "Fonte de tipos, marcas, modelos, versões e anos de veículos.")
System_Ext(email, "Serviço de e-mail", "Notificações agrupadas.")
System_Ext(google, "Google (OpenID Connect)", "Prova quem é a pessoa no login. Não há senha própria.")

Rel(comprador, sistema, "Lança pedidos, compara ofertas e negocia", "HTTPS")
Rel(vendedor, sistema, "Mantém catálogo, recebe cotações e envia propostas", "HTTPS")
Rel(admin, sistema, "Modera e aprova", "HTTPS")

Rel(sistema, fipe, "Sincroniza veículos periodicamente", "HTTPS/JSON")
Rel(sistema, email, "Envia e-mails", "API ou SMTP")
Rel(sistema, google, "Confirma a identidade no login (código + PKCE)", "HTTPS/OIDC")

Rel_R(comprador, vendedor, "Combinam pagamento e entrega\nFORA do sistema, pelo meio que escolherem")

SHOW_LEGEND()
@enduml
